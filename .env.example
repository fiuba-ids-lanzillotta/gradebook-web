# Copiá este archivo como .env y completá los valores.
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)

# Clave secreta usada por Flask para firmar las sesiones (solo gradebook-web).
# Generá una aleatoria, por ejemplo con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiame-por-una-clave-aleatoria

# URL base de la API del backend (gradebook-api).
# Opcional (default: http://localhost:5000/gradebook_api).
# El login del panel de administración se valida contra esta API; las
# credenciales de admin viven en el .env de gradebook-api, no acá.
API_BASE_URL=http://localhost:5000/gradebook_api

# API key para consumir gradebook-api. Debe coincidir con la API_KEY del backend.
# Si el backend no la exige (API_KEY vacía allá), dejá esto vacío.
API_KEY=

# ---------------------------------------------------------------
# reCAPTCHA v2 (checkbox "No soy un robot")
# ---------------------------------------------------------------
# Site key PÚBLICA que se renderiza en el widget del login. NO es secreta
# (viaja al navegador). El secret vive solo en gradebook-api (RECAPTCHA_SECRET).
# Generá el par site key / secret en https://www.google.com/recaptcha/admin
# Para desarrollo podés usar las claves de test de Google (siempre validan):
#   Site key: 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
#   Secret:   6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
# Si dejás esto vacío, el widget no se muestra (login sin captcha).
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_SUPPRESS_SEND=false